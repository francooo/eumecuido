{
  "expo": {
    "name": "Gentle Care",
    "slug": "gentle-care-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "gentlecare",
    "updates": {
      "enabled": false
    },
    "splash": {
      "backgroundColor": "#f6f8f7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gentlecare.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f6f8f7"
      },
      "package": "com.gentlecare.mobile"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
